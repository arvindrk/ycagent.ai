{
    "name": "ycagent.ai",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "typecheck": "tsc --noEmit && npm run typecheck:logview",
        "typecheck:logview": "tsc -p agent/local/logview/tsconfig.json --noEmit",
        "verify": "npm run lint && npm run typecheck && npm run build && npm run eval:smoke",
        "db:migrate": "dotenvx run -- tsx scripts/run-migration.ts",
        "db:ingest-yc": "dotenvx run -- tsx scripts/ingest-yc-companies.ts",
        "db:test": "dotenvx run -- tsx scripts/test-queries.ts",
        "test:search": "dotenvx run -- tsx scripts/test-search.ts",
        "test:semantic": "tsx scripts/test-semantic-search-exhaustive.ts",
        "test:crawler": "dotenvx run -- tsx scripts/test-crawler.ts",
        "eval:research-smoke": "tsx src/eval/smoke.ts",
        "eval:search-filter-smoke": "tsx src/eval/search-filter-smoke.ts",
        "eval:build-filter-sql-smoke": "tsx src/eval/build-filter-sql-smoke.ts",
        "eval:parse-search-filters-smoke": "tsx src/eval/parse-search-filters-smoke.ts",
        "eval:merged-filter-smoke": "tsx src/eval/merged-filter-smoke.ts",
        "eval:semantic-search-scenario-smoke": "tsx src/eval/semantic-search-scenario-smoke.ts",
        "eval:research-orchestrator-mock-eval": "tsx src/eval/research-orchestrator-mock-eval.ts",
        "eval:freshness-smoke": "tsx src/eval/freshness-smoke.ts",
        "eval:vector-ranking-smoke": "tsx src/eval/vector-ranking-smoke.ts",
        "eval:search-path-decision-smoke": "tsx src/eval/search-path-decision-smoke.ts",
        "eval:domain-coverage-matrix-smoke": "tsx src/eval/domain-coverage-matrix-smoke.ts",
        "eval:research-multi-domain-stream-contract-smoke": "tsx src/eval/research-multi-domain-stream-contract-smoke.ts",
        "eval:present-domain-tab-parity-smoke": "tsx src/eval/present-domain-tab-parity-smoke.ts",
        "eval:missing-domain-prompt-gating-smoke": "tsx src/eval/missing-domain-prompt-gating-smoke.ts",
        "eval:timeline-domain-crosslink-affordance-smoke": "tsx src/eval/timeline-domain-crosslink-affordance-smoke.ts",
        "eval:coverage-active-tab-highlight-smoke": "tsx src/eval/coverage-active-tab-highlight-smoke.ts",
        "eval:timeline-jump-active-state-smoke": "tsx src/eval/timeline-jump-active-state-smoke.ts",
        "eval:timeline-results-nav-always-visible-smoke": "tsx src/eval/timeline-results-nav-always-visible-smoke.ts",
        "eval:relative-freshness-label-smoke": "tsx src/eval/relative-freshness-label-smoke.ts",
        "eval:smoke": "npm run eval:research-smoke && npm run eval:search-filter-smoke && npm run eval:build-filter-sql-smoke && npm run eval:parse-search-filters-smoke && npm run eval:merged-filter-smoke && npm run eval:semantic-search-scenario-smoke && npm run eval:research-orchestrator-mock-eval && npm run eval:freshness-smoke && npm run eval:vector-ranking-smoke && npm run eval:search-path-decision-smoke && npm run eval:domain-coverage-matrix-smoke && npm run eval:research-multi-domain-stream-contract-smoke && npm run eval:present-domain-tab-parity-smoke && npm run eval:missing-domain-prompt-gating-smoke && npm run eval:timeline-domain-crosslink-affordance-smoke && npm run eval:coverage-active-tab-highlight-smoke && npm run eval:timeline-jump-active-state-smoke && npm run eval:timeline-results-nav-always-visible-smoke && npm run eval:relative-freshness-label-smoke",
        "test:logview": "node --import tsx --test \"agent/local/logview/__tests__/*.test.ts\" \"agent/local/logview/__tests__/*.test.tsx\"",
        "logs": "tsx agent/local/logview/index.tsx",
        "watch": "bash agent/local/watch.sh",
        "watch:once": "bash agent/local/merge-watch.sh",
        "watch:dry-run": "bash agent/local/merge-watch.sh --dry-run"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.74.0",
        "@e2b/desktop": "^2.2.2",
        "@google/genai": "^1.40.0",
        "@mendable/firecrawl-js": "^4.12.1",
        "@neondatabase/serverless": "^1.0.2",
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-avatar": "^1.1.11",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.2.6",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@tanstack/react-query": "^5.90.19",
        "@trigger.dev/react-hooks": "4.4.1",
        "@trigger.dev/sdk": "4.4.1",
        "@xdevplatform/xdk": "^0.4.0",
        "ai": "^6.0.86",
        "better-auth": "^1.4.18",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "ink": "^7.1.0",
        "lucide-react": "^0.562.0",
        "next": "16.1.6",
        "next-themes": "^0.4.6",
        "openai": "^6.16.0",
        "playwright": "^1.58.2",
        "posthog-js": "^1.352.0",
        "posthog-node": "^5.24.17",
        "radix-ui": "^1.4.3",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "sharp": "^0.34.5",
        "skills": "^1.3.1",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.4.0",
        "tailwindcss-animate": "^1.0.7",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@dotenvx/dotenvx": "^1.52.0",
        "@tailwindcss/postcss": "^4",
        "@tanstack/eslint-plugin-query": "^5.91.3",
        "@trigger.dev/build": "4.4.1",
        "@types/node": "^20",
        "@types/pg": "^8.16.0",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.1.4",
        "ink-testing-library": "^4.0.0",
        "pg": "^8.17.2",
        "schema-dts": "^1.1.5",
        "shadcn": "^3.7.0",
        "tailwindcss": "^4",
        "tsx": "^4.19.2",
        "typescript": "^5"
    }
}
